<?xml version='1.0' encoding='utf-8'?>
<widget id="com.pawtag.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>PawTagApp</name>
    <description>
        Paw Tag mobile dashboard shell (Cordova wrapper around the Angular app).
    </description>
    <author email="dev@pawtag.app" href="https://pawtag.app">
        Paw Tag Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="android-compileSdkVersion" value="36" />
    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-feature android:name="android.hardware.camera" android:required="true" />
            <uses-feature android:name="android.hardware.camera.autofocus" android:required="true" />
        </config-file>
    </platform>
</widget>
